   "dai": "春廿首春",
   "kotobagaki": ""
  },
  {
   "seq": "15",
   "text": "雲とのみよそよりみつる色もかな花にはけなる春の春の春の山",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-729535",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "春廿首春",
   "kotobagaki": ""
  },
  {
   "seq": "16",
   "text": "さ九らはなあたに散とて恨しき浮世のうちはつゝらてもまた",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-729535",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "春廿首春",
   "kotobagaki": ""
  },
  {
   "seq": "17",
   "text": "山あらしのあらしすきつる一とをり花のふきに空とちぬなり",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-729535",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "春廿首春",
   "kotobagaki": ""
  },
  {
   "seq": "18",
   "text": "はなしそめしこゝろをやりてうつすとはいはてものかしやま吹の色",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-729535",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "春廿首春",
   "kotobagaki": ""
  },
  {
   "seq": "19",
   "text": "うち霞みはるとのふかきあけほのゝあたき岸にさける藤なみ",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-729535",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "春廿首春",
   "kotobagaki": ""
  },
  {
   "seq": "20",
   "text": "春もはやあはれやく夜に有明の月か斗ほそき横愛のそう",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-729535",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "春廿首春",
   "kotobagaki": ""
  },
  {
   "seq": "21",
   "text": "爰ころもたちかへしても忘れぬはいかれし春の花そめの袖",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-729535",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "夏十五首夏",
   "kotobagaki": ""
  },
  {
   "seq": "22",
   "text": "しのひねはふ気てやきくとあときすいもねぬよりをかさねてそまつ",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-729535",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "夏十五首夏",
   "kotobagaki": ""
  },
  {
   "seq": "23",
   "text": "月はいか木のまはつかに見えそめて山あとゝきす一こゑもなく",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-729535",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "夏十五首夏",
   "kotobagaki": ""
  },
  {
   "seq": "24",
   "text": "むら両はくもりもはてぬひとそゝきはれゆく空になく本とゝきん",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-729535",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "夏十五首夏",
   "kotobagaki": ""
  },
  {
   "seq": "25",
   "text": "にしのこつふもとの雲にたすきて津をもさなからと待さなへかな",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-729535",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "夏十五首夏",
   "kotobagaki": ""
  },
  {
   "seq": "26",
   "text": "月着もる軒はの風の飛とふきにねやのおくまてにほふたち図",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-729535",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "夏十五首夏",
   "kotobagaki": ""
  },
  {
   "seq": "27",
   "text": "さみたれはしはしたえもとみる本とになをもふかしをちこちの山",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-729535",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "夏十五首夏",
   "kotobagaki": ""
  },
  {
   "seq": "28",
   "text": "つれ〳〵とあまるなかめはつら〳〵とくゝしかねたるしこれのころ",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-729535",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "夏十五首夏",
   "kotobagaki": ""
  },
  {
   "seq": "29",
   "text": "ならゑはのたかき木す湯に風を聞ていにたにしろき月はすゝしま",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-729535",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "夏十五首夏",
   "kotobagaki": ""
  },
  {
   "seq": "30",
   "text": "かくて見舞そをたかに魏の花のため草のみとりはよしふかくとん",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-729535",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "夏十五首夏",
   "kotobagaki": ""
  },
  {
   "seq": "31",
   "text": "月にまたくらき夜川の水のうへにうふねのかゝりかけそ月のめく",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-729535",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "夏十五首夏",
   "kotobagaki": ""
  },
  {
   "seq": "32",
   "text": "水窓うへにもらてもきえぬほしかるこそ風にうこかぬひかりなりけれ",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-729535",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "夏十五首夏",
   "kotobagaki": ""
  },
  {
   "seq": "33",
   "text": "あらずる中兵衛の風の一かゝ又よこきる雨にいなぼらしかけ",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-729535",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "夏十五首夏",
   "kotobagaki": ""
  },
  {
   "seq": "34",
   "text": "つきのとふむかひきしに滝落てすゝしさふかき松のした道",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-729535",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "夏十五首夏",
   "kotobagaki": ""
  },
  {
   "seq": "35",
   "text": "おほぬさやあさのゆふしてあなひきみそきすゝしきよもの河風",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-729535",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "夏十五首夏",
   "kotobagaki": ""
  },
  {
   "seq": "36",
   "text": "一餘はまゝ野の色みたに知かなくになにそこゝ路にうかふあはれは",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-729535",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "秋丑首秋",
   "kotobagaki": ""
  },
  {
   "seq": "37",
   "text": "あまつほしゆきあふ夜半は我さへにこゝろそみなるなかめをそする",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-729535",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "秋丑首秋",
   "kotobagaki": ""
  },
  {
   "seq": "38",
   "text": "袖のつなもいかゝくゝくる荻の葉におよやうれへの毎風のとき",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-729535",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "秋丑首秋",
   "kotobagaki": ""
  },
  {
   "seq": "39",
   "text": "つねよりも言ろうつろふなかめかなましこのまゝつゆの玉はき",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-729535",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "秋丑首秋",
   "kotobagaki": ""
  },
  {
   "seq": "40",
   "text": "かけにはみうつるとなしの秋の日にかりかねさむしうすとのそう",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-729535",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "秋丑首秋",
   "kotobagaki": ""
  },
  {
   "seq": "41",
   "text": "さよふかく枕の山の松風にたくふをしかのこゑもまちかし",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-729535",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "秋丑首秋",
   "kotobagaki": ""
  },
  {
   "seq": "42",
   "text": "うけてむかふこゝろよりこそかなしきれわんれてみはや秋も夕部も",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-729535",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "秋丑首秋",
   "kotobagaki": ""
  },
  {
   "seq": "43",
   "text": "一見渡勢ははるかにつゝくを山たの色こきかし畳かりそめにけり",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-729535",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "秋丑首秋",
   "kotobagaki": ""
  },
  {
   "seq": "44",
   "text": "秋風のこすゑをはらふゆふくれに雲もかゝららぬや方のはの月",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-729535",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "秋丑首秋",
   "kotobagaki": ""
  },
  {
   "seq": "45",
   "text": "うれしくも月も秋しも長きよくにてはあかぬなかぬなかめとおもへは",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-729535",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "秋丑首秋",
   "kotobagaki": ""
  },
  {
   "seq": "46",
   "text": "見るまゝ名すかたはかりか月はたゝこゝろのそこにすみけるものを",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-729535",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "秋丑首秋",
   "kotobagaki": ""
  },
  {
   "seq": "47",
   "text": "人はたれか月みりほかのかけに見すあれていくよの秋の古今",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-729535",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "秋丑首秋",
   "kotobagaki": ""
  },
  {
   "seq": "48",
   "text": "秋ふかきありあけの月の秋さむしあさち色つくはつ霜のには",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-729535",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "秋丑首秋",
   "kotobagaki": ""
  },
  {
   "seq": "49",
   "text": "月はましかけ見へそめぬ草むらのつゆにもしるゝ虫のこゑ〳〵",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-729535",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "秋丑首秋",
   "kotobagaki": ""
  },
  {
   "seq": "50",
   "text": "屋へにほふ胡かの影を岸にこめて霧にきらやく秋の岩は",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-729535",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "秋丑首秋",
   "kotobagaki": ""
  },
  {
   "seq": "51",
   "text": "衣うつなれもさこそは寒からしあかつきふかき霜におき井て",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-729535",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "秋丑首秋",
   "kotobagaki": ""
  },
  {
   "seq": "52",
   "text": "うつるなき霜はをくとも菊の花またとさくへき色しなけれは",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-729535",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "秋丑首秋",
   "kotobagaki": ""
  },
  {
   "seq": "53",
   "text": "もす者なく岩すそのゝ夕つく日色見えそ無類はしの一日は",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-729535",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "秋丑首秋",
   "kotobagaki": ""
  },
  {
   "seq": "54",
   "text": "たつね入山より屋方ゑかさなれは庄みちもふかき色そそひける",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-729535",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "秋丑首秋",
   "kotobagaki": ""
  },
  {
   "seq": "55",
   "text": "秋もいまつれてやいぬる夕暮のあらしにはやき雲のむとむら",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-729535",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "秋丑首秋",
   "kotobagaki": ""
  },
  {
   "seq": "56",
   "text": "かきくらしのきはのそらはしらるれはあらし名すまに雲気晴ゆく",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-729535",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "冬十五首",
   "kotobagaki": ""
  },
  {
   "seq": "57",
   "text": "嵐にふるや禁の飛とくそるみすはしぐれにきゝまかへまし",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-729535",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "冬十五首",
   "kotobagaki": ""
  },
  {
   "seq": "58",
   "text": "一和気てゆくあともすくなき道野へ忠をさゝかうへにこほ出朝しも",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-729535",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "冬十五首",
   "kotobagaki": ""
  },
  {
   "seq": "59",
   "text": "かれはつるいろこそかはれ猶秋宿おもか斗のこるおはなかるかや",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-729535",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "冬十五首",
   "kotobagaki": ""
  },
  {
   "seq": "60",
   "text": "山川や秋者なこりを猶とめて庭りにすけるそこのもみちは",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-729535",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "冬十五首",
   "kotobagaki": ""
  },
  {
   "seq": "61",
   "text": "霜か雪かはゝれにみゆる庭の上に肩れる自然影のたけき",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-729535",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "冬十五首",
   "kotobagaki": ""
  },
  {
   "seq": "62",
   "text": "浦風に雪ふきませてなにはかしあれたるなみに千鳥なくなり",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-729535",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "冬十五首",
   "kotobagaki": ""
  },
  {
   "seq": "63",
   "text": "さえわふるねさめのとこのふかきみにきくもさひしきをしのごゑ",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-729535",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "冬十五首",
   "kotobagaki": ""
  },
  {
   "seq": "64",
   "text": "竹のはにありしもさん〳〵遊ふくれの雲のゆくてに霞ちるなり",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-729535",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "冬十五首",
   "kotobagaki": ""
  },
  {
   "seq": "65",
   "text": "おもすからのあらしのまゝの跡なれやむら〳〵したすきけ朝のはつ雲",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-729535",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "冬十五首",
   "kotobagaki": ""
  },
  {
   "seq": "66",
   "text": "降つもる雪のこのまの朝つゝひ花に庭りし春のおもかけ",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-729535",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "冬十五首",
   "kotobagaki": ""
  },
  {
   "seq": "67",
   "text": "ふりはて雲はむらしほるよの月にみか斗留雪のをやま",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-729535",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "冬十五首",
   "kotobagaki": ""
  },
  {
   "seq": "68",
   "text": "みかりするかし野の原のおち草はなくるもほとにつもるしらむ雪",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-729535",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "冬十五首",
   "kotobagaki": ""
  },
  {
   "seq": "69",
   "text": "すみかまのけふりは下になひきつゝ雪ふきかくるをのゝふかせ",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-729535",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "冬十五首",
   "kotobagaki": ""
  },
  {
   "seq": "70",
   "text": "くれてゆくとしはわか身にそふ物をおまへははてのあはれなもかな",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-729535",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "冬十五首",
   "kotobagaki": ""
  },
  {
   "seq": "71",
   "text": "吹かせのつてにもいかてしらせましかゝるおもひのあり。そはかりも",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-729535",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "一応廿首徳",
   "kotobagaki": ""
  },
  {
   "seq": "72",
   "text": "さてにそのはれまやいつそあま雲のみたれたちぬる声うらみ母",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-729535",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "一応廿首徳",
   "kotobagaki": ""
  },
  {
   "seq": "73",
   "text": "人しれぬこゝろひとつのおもひよりむ手に煙りのたえぬ方もなし",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-729535",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "一応廿首徳",
   "kotobagaki": ""
  },
  {
   "seq": "74",
   "text": "ふりすなになみたの露はしけくとも人をしのたの森のことのは",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-729535",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "一応廿首徳",
   "kotobagaki": ""
  },
  {
   "seq": "75",
   "text": "こえてこそなをまとはるれ逢坂の関のあなしをなになけさせん",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-729535",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "一応廿首徳",
   "kotobagaki": ""
  },
  {
   "seq": "76",
   "text": "いまよりのとたえよましてうちはしのなかきちきりもこのむとやおもふ",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-729535",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "一応廿首徳",
   "kotobagaki": ""
  },
  {
   "seq": "77",
   "text": "あま人の玉もかりほす袖のうへにわれこちぬれぬなみのよるゝ",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-729535",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "一応廿首徳",
   "kotobagaki": ""
  },
  {
   "seq": "78",
   "text": "きぬしになれぬらしつる衣手につゆわけそふるみちのさゝはら",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-729535",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "一応廿首徳",
   "kotobagaki": ""
  },
  {
   "seq": "79",
   "text": "いのりこししるしや何そ日にそへてつらなみこそみての神板",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-729535",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "一応廿首徳",
   "kotobagaki": ""
  },
  {
   "seq": "80",
   "text": "にほとりのしたのかよひちた覚くらは波のうき春はうかれたつとも",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-729535",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "一応廿首徳",
   "kotobagaki": ""
  },
  {
   "seq": "81",
   "text": "ひとりのみふすゐのかるもかきつゝしおもふおもひにあけかしきこと",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-729535",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "一応廿首徳",
   "kotobagaki": ""
  },
  {
   "seq": "82",
   "text": "たのめねはまつともなしの夕くれにせかしやいかにさゝかにの糸",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-729535",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "一応廿首徳",
   "kotobagaki": ""
  },
  {
   "seq": "83",
   "text": "むかはましあわれならましますかゝみ見なれし人のかけのとまらは",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-729535",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "一応廿首徳",
   "kotobagaki": ""
  },
  {
   "seq": "84",
   "text": "たのめつ留くれを万つよの床の上にぬれてのうれるつけのをまへら",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-729535",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "一応廿首徳",
   "kotobagaki": ""
  },
  {
   "seq": "85",
   "text": "まちたとてはらはぬとこゑすかむしろなみたのとによしくちも世よ",
   "kana": "",
   "speaker": "",
   "page": 8,
   "pid": "nao-729535",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "一応廿首徳",
   "kotobagaki": ""
  },
  {
   "seq": "86",
   "text": "なかれいつるなみたにそ帰る紅井のやし同の蕗もあさることはみし",
   "kana": "",
   "speaker": "",
   "page": 8,
   "pid": "nao-729535",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "一応廿首徳",
   "kotobagaki": ""
  },
  {
   "seq": "87",
   "text": "したひしのとけてもとけぬこゝろこそありしよりなをむす内をれけれは",
   "kana": "",
   "speaker": "",
   "page": 8,
   "pid": "nao-729535",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "一応廿首徳",
   "kotobagaki": ""
  },
  {
   "seq": "88",
   "text": "和すれしのちきりにいまやしら方弓弓はかひくかたにたのむはかりか",
   "kana": "",
   "speaker": "",
   "page": 8,
   "pid": "nao-729535",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "一応廿首徳",
   "kotobagaki": ""
  },
  {
   "seq": "89",
   "text": "和かゝたはおもはぬなみにとまりすかあしまのをふねさそさはくらん",
   "kana": "",
   "speaker": "",
   "page": 8,
   "pid": "nao-729535",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "一応廿首徳",
   "kotobagaki": ""
  },
  {
   "seq": "90",
   "text": "ゆふくれはさてもとおもふあはれよりなみたににはふいりなひのかね",
   "kana": "",
   "speaker": "",
   "page": 8,
   "pid": "nao-729535",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "一応廿首徳",
   "kotobagaki": ""
  },
  {
   "seq": "91",
   "text": "ふもとのとりのはつねもほの〳〵とまたくもふかきあかつきのそら",
   "kana": "",
   "speaker": "",
   "page": 8,
   "pid": "nao-729535",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "十首雑ナ首",
   "kotobagaki": ""
  },
  {
   "seq": "92",
   "text": "かゝけてもほのほみしかき灯のまとにしたぬ雨のよすから",
   "kana": "",
   "speaker": "",
   "page": 8,
   "pid": "nao-729535",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "十首雑ナ首",
   "kotobagaki": ""
  },
  {
   "seq": "93",
   "text": "波しろきうら半の松のはこしよりかくれあかはれ見ゆる内ふね",
   "kana": "",
   "speaker": "",
   "page": 8,
   "pid": "nao-729535",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "十首雑ナ首",
   "kotobagaki": ""
  },
  {
   "seq": "94",
   "text": "うきふしもよしや世中いくほとゝなくさめて見る庭のくれ竹",
   "kana": "",
   "speaker": "",
   "page": 8,
   "pid": "nao-729535",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "十首雑ナ首",
   "kotobagaki": ""
  },
  {
   "seq": "95",
   "text": "とりかへるふもとのはやし日はくれてのきはの山にやと類し羅くも",
   "kana": "",
   "speaker": "",
   "page": 8,
   "pid": "nao-729535",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "十首雑ナ首",
   "kotobagaki": ""
  },
  {
   "seq": "96",
   "text": "秋はつるたつかのいほはかたはよりひたむきすてゝする人もなし",
   "kana": "",
   "speaker": "",
   "page": 8,
   "pid": "nao-729535",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "十首雑ナ首",
   "kotobagaki": ""
  },
  {
   "seq": "97",
   "text": "大かたもいつしかゝりの屋とならぬたひとてなにかさのみかなしき",
   "kana": "",
   "speaker": "",
   "page": 8,
   "pid": "nao-729535",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "十首雑ナ首",
   "kotobagaki": ""
  },
  {
   "seq": "98",
   "text": "入かゝる日かけは山のはつかにてさとのつしきに遣ふりたつみゆ",
   "kana": "",
   "speaker": "",
   "page": 8,
   "pid": "nao-729535",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "十首雑ナ首",
   "kotobagaki": ""
  },
  {
   "seq": "99",
   "text": "なをすへてくるしいとはしいくほとのいのちまつ方のまとはおわへと",
   "kana": "",
   "speaker": "",
   "page": 8,
   "pid": "nao-729535",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "十首雑ナ首",
   "kotobagaki": ""
  },
  {
   "seq": "100",
   "text": "君か代は千とせの松のいゝたひをうゑてもつきしもゝしきの庭",
   "kana": "",
   "speaker": "",
   "page": 8,
   "pid": "nao-729535",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "十首雑ナ首",
   "kotobagaki": ""
  },
  {
   "seq": "101",
   "text": "そのまゝにそはまし見ましいたまらにおしや哀やうそのとし月",
   "kana": "",
   "speaker": "",
   "page": 8,
   "pid": "nao-729535",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "十首雑ナ首",
   "kotobagaki": ""
  },
  {
   "seq": "102",
   "text": "契りけりまちせりあはれそのときのことのはのみかみつくきのあと",
   "kana": "",
   "speaker": "",
   "page": 8,
   "pid": "nao-729535",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "十首雑ナ首",
   "kotobagaki": ""
  },
  {
   "seq": "103",
   "text": "やゝさむし風のけしきも吹なりてすさまましきかまの月におろ哉",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "nao-729535",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "十首雑ナ首",
   "kotobagaki": ""
  },
  {
   "seq": "104",
   "text": "たちかへる神代の春やしるからしたかまか原に霞たなひく",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "nao-729535",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "背二十首立春",
   "kotobagaki": ""
  },
  {
   "seq": "105",
   "text": "ふしのねの雲井にまかふ煙よりしたりかすみて春やみゆらん",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "nao-729535",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "山霞",
   "kotobagaki": ""
  },
  {
   "seq": "106",
   "text": "春やさてみるめも波にまかふらん霞をうつし伊勢のあ方人",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "nao-729535",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "浦霞",
   "kotobagaki": ""
  },
  {
   "seq": "107",
   "text": "春浅くわかなはましき野辺に出て雪見んためと人やおもはん",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "nao-729535",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "若菜",
   "kotobagaki": ""
  }
 ],
