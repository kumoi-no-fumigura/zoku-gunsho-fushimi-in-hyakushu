 "poems": [
  {
   "seq": "1",
   "text": "長閑なるこゝろにやかてしゝれけりけふへはちかいる春のしましは",
   "kana": "",
   "speaker": "",
   "page": 3,
   "pid": "nao-729535",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "春廿首春",
   "kotobagaki": ""
  },
  {
   "seq": "2",
   "text": "にほひつる霞のうちの朝つゝるのとけれは春冬こもれる",
   "kana": "",
   "speaker": "",
   "page": 3,
   "pid": "nao-729535",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "春廿首春",
   "kotobagaki": ""
  },
  {
   "seq": "3",
   "text": "なかめやるゆふ日の山のうす霞かすみにする松のむらたち",
   "kana": "",
   "speaker": "",
   "page": 3,
   "pid": "nao-729535",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "春廿首春",
   "kotobagaki": ""
  },
  {
   "seq": "4",
   "text": "夕つくるのとかに霜生や万毛すゑ竹のあなたに鶯の声",
   "kana": "",
   "speaker": "",
   "page": 3,
   "pid": "nao-729535",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "春廿首春",
   "kotobagaki": ""
  },
  {
   "seq": "5",
   "text": "一其丸そむ留野へのわかなの雪ませにつむねかさむた戻る袖かむ",
   "kana": "",
   "speaker": "",
   "page": 3,
   "pid": "nao-729535",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "春廿首春",
   "kotobagaki": ""
  },
  {
   "seq": "6",
   "text": "山のはの霞もさむくふる雪に春候はいはしきゆるあらしもの",
   "kana": "",
   "speaker": "",
   "page": 3,
   "pid": "nao-729535",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "春廿首春",
   "kotobagaki": ""
  },
  {
   "seq": "7",
   "text": "してまたひと人の梅のし路たへに雪のしたなる色そまかへる",
   "kana": "",
   "speaker": "",
   "page": 3,
   "pid": "nao-729535",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "春廿首春",
   "kotobagaki": ""
  },
  {
   "seq": "8",
   "text": "くれなゐの色ことにさゝ梅の花しぼやののまにあまりなるまて",
   "kana": "",
   "speaker": "",
   "page": 3,
   "pid": "nao-729535",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "春廿首春",
   "kotobagaki": ""
  },
  {
   "seq": "9",
   "text": "一花はあた柳岩糸のありみとり来る人あれ柳このころの春",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-729535",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "春廿首春",
   "kotobagaki": ""
  },
  {
   "seq": "10",
   "text": "ふりけりなをとにはたてぬ春雨のみれは草葉のうへそぬれゆく",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-729535",
   "form": "短歌",
   "genre": "",
   "ban": "",
